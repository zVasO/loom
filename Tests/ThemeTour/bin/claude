#!/bin/bash
# A stand-in for claude where the theme tour runs (CI has none): it paints a
# session's screen in the terminal's sixteen colours, writes the conversation
# the chat view shows, and waits, like an agent that has just answered. Of
# Loom's own flags only --session-id is read: it names the conversation's file.
esc=$'\033'
dim="${esc}[2m"; bold="${esc}[1m"; off="${esc}[0m"
orange="${esc}[38;5;208m"; green="${esc}[32m"; red="${esc}[31m"; cyan="${esc}[36m"; grey="${esc}[90m"
printf '%s\n' \
  "${orange}╭──────────────────────────────────────────────╮${off}" \
  "${orange}│${off} ${bold}✻ Welcome to Claude Code${off}                     ${orange}│${off}" \
  "${orange}│${off}   ${dim}/help for help, /status for your setup${off}     ${orange}│${off}" \
  "${orange}╰──────────────────────────────────────────────╯${off}" \
  "" \
  "${grey}>${off} make the imported theme follow tweakcn to the letter" \
  "" \
  "${green}⏺${off} I'll read how a theme reaches the views first." \
  "" \
  "${green}⏺${off} ${bold}Read${off}(Sources/LoomUI/ThemeStore.swift)" \
  "  ${dim}⎿  Read 912 lines${off}" \
  "" \
  "${green}⏺${off} ${bold}Update${off}(Sources/LoomUI/ThemeDesign.swift)" \
  "  ${dim}⎿  Updated with 4 additions and 2 removals${off}" \
  "     ${grey}41${off} ${red}-        if charter <= 3 { return Self.pill }${off}" \
  "     ${grey}41${off} ${green}+        if charter <= 3 { return min(charter, radius) }${off}" \
  "" \
  "${green}⏺${off} ${bold}Bash${off}(swift test --filter ThemeDesignTests)" \
  "  ${dim}⎿  ${off}${cyan}✔ Test run with 38 tests passed after 0.412 seconds.${off}" \
  "" \
  "${green}⏺${off} The radius scale now follows the theme. ${dim}(12s · ↓ 2.1k tokens)${off}" \
  "" \
  "${grey}╭──────────────────────────────────────────────────────────────╮${off}" \
  "${grey}│${off} >                                                            ${grey}│${off}" \
  "${grey}╰──────────────────────────────────────────────────────────────╯${off}" \
  "  ${dim}? for shortcuts${off}"
# In a worktree of its own (a linked worktree's .git is a file), the agent
# has changed something: the session's Git panel has a diff to show.
if [ -f .git ] && [ -f README.md ]; then
  printf '\n## Themes\n\nAn imported theme is followed to the letter.\n' >> README.md
  printf 'struct Radius {\n    let card = 14\n    let control = 8\n}\n' > Radius.swift
  # LOOM_TOUR_LONG: a diff long enough to scroll through.
  if [ -n "$LOOM_TOUR_LONG" ]; then
    i=0
    while [ $i -lt 900 ]; do
      printf '    /// Step %s of the pass: what it reads, and what it leaves.\n    func step%s(_ input: [String: Int]) -> Int { input.values.reduce(%s, +) }\n\n' "$i" "$i" "$i"
      i=$((i + 1))
    done > Long.swift
    sed -i '' -e 's/^import /import  /' Sources/LoomUI/Components.swift Sources/LoomUI/DefaultTheme.swift 2>/dev/null || true
  fi
fi
# The conversation of the session, where claude keeps it and where the chat
# view looks for it: one file per native session, named after the id Loom
# imposed. No usage figures in it: nothing for Usage & costs to count.
session=""; previous=""
for argument in "$@"; do
  if [ "$previous" = "--session-id" ]; then session="$argument"; fi
  previous="$argument"
done
if [ -n "$session" ]; then
  # claude names the file in lowercase; macOS's bash 3.2 has no ${session,,}.
  id=$(printf '%s' "$session" | tr '[:upper:]' '[:lower:]')
  folder="$HOME/.claude/projects/loom-theme-tour"
  mkdir -p "$folder"
  # Quoted: nothing in the JSON is the shell's. sed writes the session's id.
  sed "s/@SESSION@/$id/g" > "$folder/$id.jsonl" <<'JSONL'
{"parentUuid":null,"isSidechain":false,"sessionId":"@SESSION@","type":"user","message":{"role":"user","content":"Make the imported theme follow tweakcn to the letter."},"uuid":"00000000-0000-4000-8000-000000000001","timestamp":"2026-09-02T18:13:02.118Z"}
{"parentUuid":"00000000-0000-4000-8000-000000000001","isSidechain":false,"sessionId":"@SESSION@","type":"assistant","message":{"id":"msg_tour_01","type":"message","role":"assistant","content":[{"type":"text","text":"I'll read how a theme reaches the views first."}]},"uuid":"00000000-0000-4000-8000-000000000002","timestamp":"2026-09-02T18:13:04.302Z"}
{"parentUuid":"00000000-0000-4000-8000-000000000002","isSidechain":false,"sessionId":"@SESSION@","type":"assistant","message":{"id":"msg_tour_01","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_tour_read","name":"Read","input":{"file_path":"/Users/ada/loom/Sources/LoomUI/ThemeDesign.swift"}}]},"uuid":"00000000-0000-4000-8000-000000000003","timestamp":"2026-09-02T18:13:04.911Z"}
{"parentUuid":"00000000-0000-4000-8000-000000000003","isSidechain":false,"sessionId":"@SESSION@","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_tour_read","type":"tool_result","content":"     1\timport SwiftUI\n     2\t\n     3\t/// What an imported theme brings beyond its colours (ADR-0022).\n     4\tpublic struct ThemeDesign: Equatable, Sendable {\n     5\t    public var radius: CGFloat?\n     6\t    public var spacing: CGFloat?\n     7\t}"}]},"uuid":"00000000-0000-4000-8000-000000000004","timestamp":"2026-09-02T18:13:05.040Z"}
{"parentUuid":"00000000-0000-4000-8000-000000000004","isSidechain":false,"sessionId":"@SESSION@","type":"assistant","message":{"id":"msg_tour_02","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_tour_bash","name":"Bash","input":{"command":"swift test --filter ThemeDesignTests","description":"Run the theme design tests"}}]},"uuid":"00000000-0000-4000-8000-000000000005","timestamp":"2026-09-02T18:13:09.527Z"}
{"parentUuid":"00000000-0000-4000-8000-000000000005","isSidechain":false,"sessionId":"@SESSION@","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_tour_bash","type":"tool_result","content":"✔ Test run with 38 tests passed after 0.412 seconds.","is_error":false}]},"uuid":"00000000-0000-4000-8000-000000000006","timestamp":"2026-09-02T18:13:12.660Z"}
{"parentUuid":"00000000-0000-4000-8000-000000000006","isSidechain":false,"sessionId":"@SESSION@","type":"assistant","message":{"id":"msg_tour_03","type":"message","role":"assistant","content":[{"type":"text","text":"## The radius follows the theme\n\nAn imported theme is now followed **to the letter**: `DefaultTheme.radius(6)` hands back the theme's own `--radius`, as [tweakcn](https://tweakcn.com) exports it.\n\n- Geometry\n  - radius, from `--radius`\n  - spacing, from `--spacing`\n- Type\n  - fonts, from `--font-sans` and `--font-mono`\n  - letter-spacing, from `--tracking-normal`\n\n| Token | Charter | neo-brutalism |\n| --- | --- | --- |\n| Card radius | 10 | 0 |\n| Control radius | 6 | 0 |\n| Tag radius | 3 | 0 |\n\n```swift\nfunc radius(_ charter: CGFloat) -> CGFloat {\n    guard let radius = design?.radius else { return charter }\n    return charter <= 3 ? min(charter, radius) : radius * charter / 10\n}\n```\n\nTo check it in the running container:\n\n```bash\nFOO=1 docker exec -it web sh -c \"ls $HOME\" | grep -v tmp && echo done # quick look\n```"}]},"uuid":"00000000-0000-4000-8000-000000000007","timestamp":"2026-09-02T18:13:16.073Z"}
{"parentUuid":"00000000-0000-4000-8000-000000000007","isSidechain":false,"sessionId":"@SESSION@","type":"user","message":{"role":"user","content":[{"type":"image","source":{"type":"base64","media_type":"image/png","data":"iVBORw0KGgoAAAANSUhEUgAAAGAAAABACAIAAABqVuVZAAAAfUlEQVR42u3YoQ0AIAwAwQ5CgkMwF5K12QOLIJUYLvkJTn601pUUCAABAgQIECBAgHQFKqUqCRAgQIAAAQIECJAAAQIECBCgszXmmwABAgQIECBAgAABAgQIECBAgPwgQIAAAQIECBAgCoAAAQIECBAgQAIECBAgQIAA/dQG9YNqrLoSa20AAAAASUVORK5CYII="}},{"type":"text","text":"[Image #1] Does a built-in theme still draw as before?"}]},"uuid":"00000000-0000-4000-8000-000000000008","timestamp":"2026-09-02T18:13:41.950Z"}
{"parentUuid":"00000000-0000-4000-8000-000000000008","isSidechain":false,"sessionId":"@SESSION@","type":"assistant","message":{"id":"msg_tour_04","type":"message","role":"assistant","content":[{"type":"text","text":"Yes. A theme without a design of its own hands every charter value back unchanged, and the tour pictures it beside the imported ones.\n\n### What was checked\n\n| Point | In the code | Verdict |\n| --- | --- | --- |\n| #1 Built-in themes | **Confirmed.** `ThemePalette.design` is nil for every built-in family, so `radius(_:)`, `space(_:)` and `themeFont` hand the charter's own values back unchanged. | Agreed: nothing to do. Nine static screens compare pixel for pixel with the pictures taken before the change. |\n| #4 Colours only | **Confirmed**, with a nuance: the theme's `--border` and `--input` still apply, because an edge is a colour. | Agreed in part. The radius, the spacing and the fonts stay Loom's; say so in the preview's summary line. |\n| #9 Letter-spacing | Consistent with what tweakcn shows at 14 px (« supposed »). | Nuance: under 14 pt a tighter theme lets go, down to nothing at 10 pt. |\n\n| Point | Verdict |\n| --- | --- |\n| #7 Fonts | Agreed. Only the sans and the mono are fetched from Google Fonts, and only for the theme in use — a family Google does not know is noted and never asked for again. |\n| #15 Shadows | Agreed. A sidebar's session cards carry none: a hard shadow welded each card to the next. |\n"}]},"uuid":"00000000-0000-4000-8000-000000000009","timestamp":"2026-09-02T18:13:44.281Z"}
JSONL
  # LOOM_TOUR_LONG: the same exchange many times over, a conversation to scroll.
  if [ -n "$LOOM_TOUR_LONG" ]; then
    base=$(grep -n 'msg_tour_04' "$folder/$id.jsonl" | head -1 | cut -d: -f1)
    i=0
    while [ $i -lt 40 ]; do
      sed -n "$((base - 1)),${base}p" "$folder/$id.jsonl" | sed -e "s/-0000000000\([0-9][0-9]\)\"/-10${i}00000\1\"/g"
      i=$((i + 1))
    done > "$folder/$id.more" && cat "$folder/$id.more" >> "$folder/$id.jsonl" && rm "$folder/$id.more"
  fi
fi
# LOOM_TOUR_PERMISSION: the worktree's session then ends on a permission
# prompt, drawn as claude draws one, and says which key answered it.
if [ -n "$LOOM_TOUR_PERMISSION" ] && [ -f .git ]; then
  printf '%s\n' "" \
    "╭──────────────────────────────────────────────────────────╮" \
    "│ Bash command                                             │" \
    "│                                                          │" \
    "│   git push origin loom/follow-the-letter                 │" \
    "│   Push the branch to the remote                          │" \
    "│                                                          │" \
    "│ Do you want to proceed?                                  │" \
    "│ ❯ 1. Yes                                                 │" \
    "│   2. Yes, and don't ask again for git push commands      │" \
    "│   3. No, and tell Claude what to do differently (esc)    │" \
    "╰──────────────────────────────────────────────────────────╯"
  IFS= read -rsn1 key
  printf '\n%s answered: %s\n' "${green}⏺${off}" "$key"
fi
# Until the session is closed.
exec cat > /dev/null
