      {"kind": "mouseDown", "x": 100, "y": 50, "button": 0, "clickCount": 1, "modifiers": 0},
      {"kind": "mouseUp", "x": 100, "y": 50, "button": 0, "clickCount": 1, "modifiers": 0}
