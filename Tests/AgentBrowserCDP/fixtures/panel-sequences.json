  {
    "name": "Japanese input: the marked text grows, converts, then commits — no key event",
    "input": [
      {"kind": "keyDown", "keyCode": 40, "characters": "k", "modifiers": 0, "actions": [{"setMarkedText": "k", "location": 1, "length": 0}]},
      {"kind": "keyUp", "keyCode": 40, "characters": "k", "modifiers": 0},
      {"kind": "keyDown", "keyCode": 0, "characters": "a", "modifiers": 0, "actions": [{"setMarkedText": "か", "location": 1, "length": 0}]},
      {"kind": "keyUp", "keyCode": 0, "characters": "a", "modifiers": 0},
      {"kind": "keyDown", "keyCode": 49, "characters": " ", "modifiers": 0, "actions": [{"setMarkedText": "蚊", "location": 0, "length": 1}]},
      {"kind": "keyUp", "keyCode": 49, "characters": " ", "modifiers": 0},
      {"kind": "keyDown", "keyCode": 36, "characters": "\r", "modifiers": 0, "actions": [{"insertText": "蚊"}]},
      {"kind": "keyUp", "keyCode": 36, "characters": "\r", "modifiers": 0}
    ],
    "expected": [
      {"method": "Input.imeSetComposition", "params": {"text": "k", "selectionStart": 1, "selectionEnd": 1}},
      {"method": "Input.imeSetComposition", "params": {"text": "か", "selectionStart": 1, "selectionEnd": 1}},
      {"method": "Input.imeSetComposition", "params": {"text": "蚊", "selectionStart": 0, "selectionEnd": 1}},
      {"method": "Input.insertText", "params": {"text": "蚊"}}
    ]
  },
